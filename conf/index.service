[Unit]
Description=Cheruby Docs: refresh the search index (__APP__)
Wants=__APP__-embed.service
After=__APP__-embed.service
# healthchecks.io, when turned on in the config panel: a failed run only.
# The indexer itself reaches loopback only.
OnFailure=__APP__-ping@fail.service

[Service]
Type=oneshot
User=__APP__
Group=__APP__
# The same groups as the tool server, to read the same files on disk.
SupplementaryGroups=__GROUPS__

# Folders, index settings and the Nextcloud app password, no MCP token. Root 600.
EnvironmentFile=__INSTALL_DIR__/index.env
ExecStart=__INSTALL_DIR__/bin/cheruby-docs index
# Stopped on purpose (Rebuild, an upgrade) is not a failed run: no failure ping.
SuccessExitStatus=SIGTERM

# The first run embeds every passage, about a second each, and yields the CPU
# to everything. A run stuck past 6 hours fails, so the schedule can start another;
# the next run resumes from the working copy. TimeoutStartSec, not
# RuntimeMaxSec, which systemd ignores for a oneshot unit.
TimeoutStartSec=6h
Nice=19
CPUWeight=10
MemoryMax=512M

# IPv4 loopback only; the ports, the app's nftables table (B-P-5).
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6

# As the tool server, plus the index folder, the only place it writes.
ProtectSystem=strict
ProtectHome=tmpfs
TemporaryFileSystem=/var/www:ro
BindReadOnlyPaths=__INSTALL_DIR__ __BIND_PATHS__
BindPaths=__DATA_DIR__
InaccessiblePaths=-/var/lib -/var/log -/var/cache -/mnt -/media -/srv -/snapshots

UMask=077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

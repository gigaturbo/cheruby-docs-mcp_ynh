[Unit]
Description=Cheruby Docs: refresh the search index (__APP__)
Wants=__APP__-embed.service
After=__APP__-embed.service
# healthchecks.io, when turned on in the config panel. The indexer itself
# reaches loopback only.
OnSuccess=__APP__-ping@0.service
OnFailure=__APP__-ping@fail.service

[Service]
Type=oneshot
User=__APP__
Group=__APP__
# The same groups as the tool server, to read the same files on disk.
SupplementaryGroups=__GROUPS__

# Folders, index settings and the Nextcloud app password, no MCP token. Root 600.
EnvironmentFile=__INSTALL_DIR__/index.env
# The start ping is sent only when a run really starts: as a Wants=, the
# timer firing during a long run sent it again. "+" runs it outside the
# sandbox, which blocks the socket systemctl talks through.
ExecStartPre=+/bin/systemctl start --no-block __APP__-ping@start.service
ExecStart=__INSTALL_DIR__/venv/bin/python -E -s -B __INSTALL_DIR__/docs_index.py

# The first run embeds every passage, about a second each, and yields the CPU
# to everything. A run stuck past 6 hours fails, so the timer can start again;
# the next run resumes from the working copy.
TimeoutStartSec=infinity
RuntimeMaxSec=6h
Nice=19
CPUWeight=10
MemoryMax=512M

IPAddressAllow=localhost
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6

# As the tool server, plus the index folder, the only place it writes.
ProtectSystem=strict
ProtectHome=tmpfs
TemporaryFileSystem=/var/www:ro
BindReadOnlyPaths=__INSTALL_DIR__ __BIND_PATHS__
BindPaths=__DATA_DIR__
InaccessiblePaths=-/var/lib -/var/log -/var/cache -/mnt -/media -/srv -/snapshots

UMask=077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

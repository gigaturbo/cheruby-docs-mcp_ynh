[Unit]
Description=Cheruby Docs: MCP tools on users' folders (__APP__)
Wants=__APP__-embed.service __APP__-rerank.service
After=network.target __APP__-embed.service

[Service]
Type=simple
User=__APP__
Group=__APP__
# Each folder's group, so its group-readable files can be read, and changed
# in a writable folder. Everything else those groups could read is hidden below.
SupplementaryGroups=__GROUPS__

# Tokens, the Nextcloud app password, folders and index settings. Root 600,
# read before privileges drop.
EnvironmentFile=__INSTALL_DIR__/docs.env
# Not -I: it would keep the server from importing its own modules beside it.
ExecStart=__INSTALL_DIR__/venv/bin/python -E -s -B __INSTALL_DIR__/cheruby_docs_mcp.py

MemoryMax=512M

# Loopback only: the AI gateway and Nextcloud are on this machine, and the
# tools need nothing else. Nextcloud is reached at 127.0.0.1:443 by its name.
IPAddressAllow=localhost
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6

# The process sees the configured folders on disk, the index and its own
# code, read-only but for the folders marked writable, and none of what the
# joined groups could otherwise read: Nextcloud's and Syncthing's code and
# config under /var/www, PHP sessions under /var/lib, their logs and caches.
ProtectSystem=strict
ProtectHome=tmpfs
TemporaryFileSystem=/var/www:ro
# First: both options fill one list, and an empty BindPaths= empties it.
BindPaths=__WRITE_PATHS__
BindReadOnlyPaths=__INSTALL_DIR__ __DATA_DIR__ __READ_PATHS__
InaccessiblePaths=-/var/lib -/var/log -/var/cache -/mnt -/media -/srv -/snapshots

# What write_file creates is 660 or 770, so the folder's group can change it.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

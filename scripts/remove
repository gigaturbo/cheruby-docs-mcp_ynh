#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

if [ -e "/etc/systemd/system/$app-index.timer" ]; then
    systemctl disable --now "$app-index.timer" --quiet 2>/dev/null || true
    ynh_safe_rm "/etc/systemd/system/$app-index.timer"
fi
systemctl stop "$app-index.service" --quiet 2>/dev/null || true
ynh_config_remove_systemd "$app-index"
ynh_safe_rm "/etc/systemd/system/$app-ping@.service"

for service in "$app" "$app-embed"; do
    if ynh_hide_warnings yunohost service status "$service" >/dev/null; then
        yunohost service remove "$service"
    fi
done
ynh_config_remove_systemd "$app-embed"
ynh_config_remove_systemd

# The app password it made in Nextcloud.
if [ -n "${nextcloud_token_user:-}" ] && docs_nextcloud_where; then
    docs_nextcloud_drop "$nextcloud_token_user"
fi

# The install dir and the user go with the manifest's resources; the index
# stays unless the app is removed with --purge. The folders are only read,
# never touched.

ynh_script_progression "Removal of $app completed"

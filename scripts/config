#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# Validators run for changed fields only: each field checks the section.
validate__healthcheck_enabled() {
    if [ "${healthcheck_enabled:-0}" = "1" ] && [ -z "${healthcheck_url:-}" ]; then
        echo "The ping URL is needed to ping healthchecks.io."
    fi
}

validate__healthcheck_url() {
    validate__healthcheck_enabled
}

# The folders of every turned-on source, then the labels Whoopy opens. The
# message goes into a double-quoted YAML string: no quote or backslash.
docs_check_folders() {
    local message="" wanted
    docs_collect_folders
    message=$(head -n 1 <<< "$folder_error$write_error")
    local -a picked=()
    IFS=, read -ra picked <<< "${whoopy_folders:-}"
    for wanted in "${picked[@]}"; do
        if [ -z "$message" ] && [ -z "${folder_path[$wanted]+x}" ]; then
            message="Whoopy access: no folder '$wanted'. Folders: $(printf '%s\n' "${!folder_path[@]}" | sort | paste -sd,)."
        fi
    done
    echo "${message//[\"\\]/?}"
}

validate__syncthing_enabled() { docs_check_folders; }
validate__syncthing_folders() { docs_check_folders; }
validate__local_enabled() { docs_check_folders; }
validate__local_folders() { docs_check_folders; }
validate__nextcloud_enabled() { docs_check_folders; }
validate__nextcloud_folders() { docs_check_folders; }
validate__syncthing_writable() { docs_check_folders; }
validate__local_writable() { docs_check_folders; }
validate__nextcloud_writable() { docs_check_folders; }

# A pasted app password, or the saved one with a new login, must open the
# account. An empty password field comes as "" or "None": it keeps the saved one.
docs_check_nextcloud() {
    local password code
    [ "${nextcloud_enabled:-0}" = 1 ] && docs_nextcloud_where || return 0
    set +o xtrace
    password=${nextcloud_password:-}
    [[ "$password" != "" && "$password" != "None" ]] || password=$(ynh_app_setting_get --key=nextcloud_password)
    code=000
    [ -z "$password" ] || code=$(docs_nextcloud_code "" "$password" | cut -d' ' -f1)
    password=""
    set -o xtrace
    case $code in
        207 | 000) ;;
        401) echo "Nextcloud refuses this app password for $nc_account." ;;
        429) echo "Nextcloud holds back logins from this server after failed ones: as root, occ security:bruteforce:reset 127.0.0.1, then save again." ;;
        404) echo "Nextcloud has no account $nc_account." ;;
        *) echo "Nextcloud answered $code for $nc_account." ;;
    esac
}

validate__nextcloud_account() { docs_check_nextcloud; }
validate__nextcloud_password() {
    set +o xtrace
    local given=0
    [[ "${nextcloud_password:-}" == "" || "${nextcloud_password:-}" == "None" ]] || given=1
    set -o xtrace
    [ "$given" = 0 ] || docs_check_nextcloud
}

# Stores a pasted app password with the trace off; its bind is null, so it is
# never read back by the traced getter.
set__nextcloud_password() {
    set +o xtrace
    if [[ "${nextcloud_password:-}" != "" && "${nextcloud_password:-}" != "None" ]]; then
        ynh_app_setting_set --key=nextcloud_password --value="$nextcloud_password"
        nc_password_set=1
    fi
    set -o xtrace
}
validate__whoopy_folders() { docs_check_folders; }

# The schedule and the quiet hours must leave a time to run.
validate__index_calendar() {
    [ "${index_schedule:-hourly}" != never ] || return 0
    [ -z "$(docs_calendar "$(docs_index_cron)" "${index_quiet:-}")" ] || return 0
    if [ "${index_schedule:-}" = custom ] && [ -z "$(docs_calendar "$(docs_index_cron)" "")" ]; then
        echo "Not a cron schedule: minute 0-59, hour 0-23, day 1-31, month 1-12, weekday 0-7 or sun-sat, and not both a day and a weekday. Such as 20 6-23 * * *."
    else
        echo "The quiet hours leave this schedule no time to run."
    fi
}
validate__index_schedule() { validate__index_calendar; }
validate__index_quiet() { validate__index_calendar; }

# Refused before it is saved when the model cannot be downloaded now.
validate__embed_model() {
    docs_embed_model
    curl --silent --fail --head --location --output /dev/null --max-time 15 \
        "$(ynh_read_manifest "resources.sources.$model_source.url")" \
        || echo "The model cannot be downloaded now; try again later."
}

# Defined for show only: a getter makes its field look changed on every save.
if [ "${1:-}" = "show" ]; then
    get__syncthing_folders() {
        jq -cn --arg v "$(ynh_app_setting_get --key=syncthing_folders)" --arg c "$(docs_syncthing_folders | cut -f1)" \
            '{value: $v, choices: ($c | split("\n") | map(select(length > 0)))}'
    }
    # The open folders' labels, and any saved one no longer open, so it shows and can be taken out.
    get__whoopy_folders() {
        docs_collect_folders
        jq -cn --arg v "$(ynh_app_setting_get --key=whoopy_folders)" --arg c "$(printf '%s\n' "${!folder_path[@]}" | sort)" \
            '{value: $v, choices: ($c | split("\n") + ($v | split(",")) | map(select(length > 0)) | unique)}'
    }
fi

# Each source's status says, per folder, what the app cannot read, checked as
# the app user with the folder's group, or for Nextcloud with its app
# password. No token is ever read by the traced getter (the bind is null):
# the trace goes to yunohost-cli.log, which nothing redacts.
ynh_app_config_show() {
    _ynh_app_config_show
    local source label path group ignore found line nc_password code="" perms=""
    local -A status=() ignores=()
    while IFS=$'\t' read -r label path ignore _; do
        ignores[$path]=$ignore
    done < <(docs_syncthing_folders)
    docs_collect_folders
    while IFS= read -r line; do
        source=local
        [[ "$line" == Syncthing* ]] && source=syncthing
        [[ "$line" == Nextcloud* ]] && source=nextcloud
        [ -n "$line" ] && status[$source]+="- **Left out**: $line"$'\n'
    done <<< "$folder_error"
    while IFS= read -r line; do
        source=local
        [[ "$line" == Syncthing* ]] && source=syncthing
        [[ "$line" == Nextcloud* ]] && source=nextcloud
        [ -n "$line" ] && status[$source]+="- **Read-only**: $line"$'\n'
    done <<< "$write_error"
    for label in $(printf '%s\n' "${!folder_path[@]}" | sort); do
        path=${folder_path[$label]}
        source=${folder_source[$label]}
        if [ "$source" = nextcloud ]; then
            set +o xtrace
            code=""
            nc_password=$(ynh_app_setting_get --key=nextcloud_password)
            if [ -z "$nc_password" ]; then
                found="no app password is saved: make one in Nextcloud and paste it above."
            # Refused before, by the indexer's last run: each new try counts against loopback.
            elif [ "$(jq -r '.nextcloud_refused // ""' "$data_dir/$docs_user.status.json" 2>/dev/null)" \
                = "$(printf '%s' "$nc_password" | sha256sum | cut -c1-16)" ]; then
                found="Nextcloud refused the app password: make another and paste it above."
            else
                read -r code perms < <(docs_nextcloud_code "${path#nextcloud:}" "$nc_password")
                case $code in
                    207) found="can be read." ;;
                    404) found="no such folder in the account of $nc_account." ;;
                    401) found="Nextcloud refuses the app password: make another and paste it above." ;;
                    429) found="Nextcloud holds back logins from this server after failed ones: as root, occ security:bruteforce:reset 127.0.0.1." ;;
                    *) found="Nextcloud does not answer." ;;
                esac
            fi
            nc_password=""
            set -o xtrace
            if [ -n "${folder_writable[$label]:-}" ] && [ "$code" = 207 ]; then
                if [[ "$perms" == *C*K* || "$perms" == *K*C* ]]; then
                    found+=" Writable: Nextcloud lets $nc_account add and change files here."
                else
                    found+=" Marked writable, but Nextcloud lets $nc_account only read it, as in a read-only share: nothing can be written."
                fi
            fi
            status[$source]+="- **$label**: $found"$'\n'
            continue
        fi
        group=$(stat -c %G "$path")
        status[$source]+="- **$label**: "
        # A find that fails, as for a path the app cannot reach, reports nothing on stdout.
        # From /: find fails when it starts in a folder the app cannot enter, as
        # YunoHost's root-only working folder.
        if ! found=$(cd / && setpriv --reuid="$app" --regid="$app" --groups="$group" \
            find "$path" \( -name '.*' -prune \) -o \( ! -readable -o -type d ! -executable \) -print 2>/dev/null); then
            status[$source]+="could not be checked: the app may not reach it, or the group $group may not read part of it."
        elif [ -z "$found" ]; then
            status[$source]+="every file can be read."
        else
            found=$(wc -l <<< "$found")
            if [ "$found" -eq 1 ]; then
                status[$source]+="1 file or folder cannot be read; the group $group needs to read it."
            else
                status[$source]+="$found files or folders cannot be read; the group $group needs to read them."
            fi
        fi
        if [ -n "${folder_writable[$label]:-}" ]; then
            found=$(cd / && setpriv --reuid="$app" --regid="$app" --groups="$group" \
                find "$path" \( -name '.*' -prune \) -o ! -writable -print 2>/dev/null | wc -l)
            if [ "$found" -eq 0 ]; then
                status[$source]+=" Writable: the app can change every file."
            else
                status[$source]+=" Writable, but the app cannot change $found files or folders: as root, chmod -R g+w '$path' lets the group $group change them."
            fi
        fi
        if [ "$source" = "syncthing" ] && [ "${ignores[$path]:-}" != "true" ]; then
            status[$source]+=" Syncthing keeps the permissions of the devices it syncs from: turn on Ignore Permissions for this folder, or they may undo a fix."
        fi
        status[$source]+=$'\n'
    done
    for source in syncthing local nextcloud; do
        ynh_return "${source}_status: $(jq -cn --arg a "${status[$source]:-No folder open.}" '{ask: $a}')"
    done

    ynh_return "index_status: $(jq -cn --arg a "$(docs_index_status)" '{ask: $a}')"

    set +o xtrace
    ynh_return "whoopy_token:"
    ynh_return "  value: '$(ynh_app_setting_get --key=whoopy_token)'"
    ynh_return "  help: 'Address for Whoopy: http://127.0.0.1:$port/mcp'"
    set -o xtrace
}

# Whether a run is going, how the last one ended, what the index holds and
# when the next run comes, from the status file docs_index.py writes.
docs_index_status() {
    local state next file="$data_dir/$docs_user.status.json"
    state=$(systemctl is-active "$app-index.service" || true)
    next=$(systemctl show "$app-index.timer" -p NextElapseUSecRealtime --value)
    [[ -n "$next" && "$next" != n/a ]] || next="none: the schedule is never."
    { cat "$file" 2>/dev/null || echo '{"result": "none"}'; } | jq -r --arg state "$state" --arg next "$next" --arg unit "$app-index" '
        def said: to_entries | map("\(.value) \({needs_ocr: "waiting for OCR"}[.key] // .key)") | join(", ");
        [ if $state == "activating" then "- **Running now**\(if .result == "running" then ", since \(.started)" else "" end)."
          elif .result == "none" then "- **No run yet.**"
          elif .result == "running" then "- **Last run**: started \(.started), stopped before the end: journalctl -u \($unit)."
          elif .result == "done" then "- **Last run**: \(.started) to \(.ended), done."
          elif .result == "paused" then "- **Last run**: \(.started) to \(.ended), paused for the quiet hours; the next run carries on."
          else "- **Last run**: \(.started) to \(.ended), failed: \(.error // "journalctl -u \($unit)")" end,
          (if $state != "activating" and (.run // {}) != {} then "- **It did**: \(.run | said)." else empty end),
          "- **The index holds**: \(if (.files // {}) == {} then "no file yet" else .files | said end).",
          "- **Next run**: \($next)"
        ] | join("\n")'
}

# The ping unit reads ping.env at each run: nothing to restart for it.
ynh_app_config_apply() {
    # The new model is fetched before anything is saved: if it fails, saving
    # the same choice again retries it.
    if [ "${changed[embed_model]:-}" = "true" ] && [ ! -f "$install_dir/model/$model_file" ]; then
        ynh_setup_source --dest_dir="$install_dir/model" --source_id="$model_source"
    fi
    _ynh_app_config_apply
    healthcheck_enabled=$(ynh_app_setting_get --key=healthcheck_enabled)
    healthcheck_url=$(ynh_app_setting_get --key=healthcheck_url)
    docs_write_ping
    # The previous user's token and index serve nobody any more. The folders stay.
    if [ "${changed[docs_user]:-}" = "true" ]; then
        ynh_app_setting_delete --key="token_${old[docs_user]}"
        ynh_safe_rm "$data_dir/${old[docs_user]}.sqlite"
        ynh_safe_rm "$data_dir/${old[docs_user]}.work.sqlite"
        ynh_print_warn "The folders are the same as for ${old[docs_user]}: check them in the sources."
    fi
    # A run going on, or one the timer starts before the embedding server
    # restarts, would mix two models' vectors in one index. docs_start arms
    # the timer again; the next run sees the new model and reads every file.
    if [ "${changed[embed_model]:-}" = "true" ]; then
        systemctl stop "$app-index.timer" "$app-index.service"
        docs_fetch_model
        docs_configure
        docs_start
        ynh_print_info "The embedding model is $embed_model. The next index run reads every file again; Run now starts it."
        return
    fi
    # The quiet hours also go to the indexer, through index.env.
    if [ "${changed[index_schedule]:-}" = "true" ] || [ "${changed[index_calendar]:-}" = "true" ] \
        || [ "${changed[index_quiet]:-}" = "true" ]; then
        docs_configure
        docs_start_timer
    fi
    local key
    # A new app password is in the settings already; the units need it.
    if [ "${nc_password_set:-0}" = 1 ]; then
        docs_configure
        ynh_systemctl --service="$app" --action="restart" --log_path="systemd" \
            --wait_until="Uvicorn running on" --timeout=60
        return
    fi
    for key in docs_user whoopy_folders syncthing_enabled syncthing_folders syncthing_only syncthing_skip \
        syncthing_writable local_enabled local_folders local_only local_skip local_writable nextcloud_enabled \
        nextcloud_account nextcloud_folders nextcloud_only nextcloud_skip nextcloud_writable; do
        if [ "${changed[$key]:-}" = "true" ]; then
            docs_configure
            ynh_systemctl --service="$app" --action="restart" --log_path="systemd" \
                --wait_until="Uvicorn running on" --timeout=60
            return
        fi
    done
}

run__new_token() {
    set +o xtrace
    ynh_app_setting_set --key=whoopy_token --value="$(ynh_string_random --length=48)"
    set -o xtrace
    docs_configure
    ynh_systemctl --service="$app" --action="restart" --log_path="systemd" \
        --wait_until="Uvicorn running on" --timeout=60
    ynh_print_info "A new token is in the panel. Paste it in Whoopy: the old one no longer works."
}

run__run_index() {
    if [ "$(systemctl is-active "$app-index.service")" = activating ]; then
        ynh_print_info "A run is already going. Its progress is under Index runs."
        return
    fi
    # Read and removed by the indexer: this run ignores the quiet hours.
    touch "$data_dir/run-now"
    chown "$app:$app" "$data_dir/run-now"
    systemctl start --no-block "$app-index.service"
    ynh_print_info "A run has started. Reopen the panel to see its progress under Index runs."
}

# The working copy goes; the published one stays for search until the next
# run replaces it.
run__rebuild_index() {
    systemctl stop "$app-index.service"
    ynh_safe_rm "$data_dir/$docs_user.work.sqlite"
    ynh_safe_rm "$data_dir/$docs_user.work.sqlite-journal"
    ynh_print_info "The index was dropped: the next run reads every file again. Press Run now to start it."
}

docs_embed_model
ynh_app_config_run "$1"

#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

docs_default_settings

# Each part is rebuilt only when what it depends on changed.
rebuild_venv=1
if [ -x "$install_dir/venv/bin/python" ] \
    && [ "$(docs_build_fingerprint)" = "${build_fingerprint:-}" ]; then
    rebuild_venv=0
fi
rebuild_llama=1
if [ -x "$install_dir/bin/llama-server" ] && [ -f "$install_dir/model/$model_file" ] \
    && [ "$(docs_llama_fingerprint)" = "${llama_fingerprint:-}" ]; then
    rebuild_llama=0
fi
if [ "$rebuild_venv" = 1 ] || [ "$rebuild_llama" = 1 ]; then
    docs_check_downloads
fi

ynh_script_progression "Stopping the tool server..."
docs_stop

if [ "$rebuild_venv" = 1 ]; then
    ynh_script_progression "Reinstalling the tool server from the locked wheels..."
    docs_build_venv
fi
if [ "$rebuild_llama" = 1 ]; then
    ynh_script_progression "Building the embedding server, about 8 minutes, and fetching its model..."
    docs_build_llama
fi

ynh_script_progression "Updating configuration files..."
docs_configure

ynh_script_progression "Starting the tool server..."
docs_start

ynh_script_progression "Upgrade of $app completed"

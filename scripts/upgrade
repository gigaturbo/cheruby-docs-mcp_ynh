#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

docs_default_settings

# llama-server and the models are fetched again only when they changed. The
# tool server's binary is installed at each upgrade.
fetch_llama=1
if [ -x "$install_dir/bin/llama-server" ] && [ -f "$install_dir/model/$model_file" ] \
    && [ -f "$install_dir/model/$rerank_model_file" ] \
    && [ "$(docs_llama_fingerprint)" = "${llama_fingerprint:-}" ]; then
    fetch_llama=0
fi
docs_check_downloads

ynh_script_progression "Stopping the tool server..."
docs_stop

# Before 0.14 a timer ran the index; the tool server runs the schedule now.
if [ -e "/etc/systemd/system/$app-index.timer" ]; then
    systemctl disable --now "$app-index.timer" --quiet 2>/dev/null || true
    ynh_safe_rm "/etc/systemd/system/$app-index.timer"
    systemctl daemon-reload
fi

# The Python of 0.10 and before, replaced by the binary.
for old in venv .uv requirements.txt cheruby_docs_mcp.py docs_files.py docs_index.py docs_text.py; do
    ynh_safe_rm "$install_dir/$old"
done
ynh_app_setting_delete --key=build_fingerprint

# The units reach 127.0.0.1 only, and the loopback table opens Whoopy's port
# from this address alone (B-P-5).
if [[ "${remote_url:-}" =~ ^http://(localhost|\[::1\])(:[0-9]+/?)$ ]]; then
    remote_url="http://127.0.0.1${BASH_REMATCH[2]}"
    ynh_app_setting_set --key=remote_url --value="$remote_url"
fi

if [ "$fetch_llama" = 1 ]; then
    ynh_script_progression "Fetching the embedding server and its models..."
    docs_fetch_llama
fi

ynh_script_progression "Installing the tool server..."
docs_install_binary

ynh_script_progression "Updating configuration files..."
docs_configure
docs_set_logo

ynh_script_progression "Starting the tool server..."
docs_start

ynh_script_progression "Upgrade of $app completed"
